{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ikjoo123-github-io",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "."
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "ikjoo-files"
    }
  ]
}
